# IPTV Control Center — example environment.
# Values are NOT stored here. Copy to .env for local development (gitignored),
# or set them in Coolify for production (locked / shown-once).

IPTV_APP_ENV=development

# SQLite for local development; PostgreSQL in production:
#   postgresql+asyncpg://user:pass@host:5432/iptv
IPTV_DATABASE_URL=sqlite+aiosqlite:///./data/iptv.db

# Public base URL used when rendering playlists and EPG links.
IPTV_PUBLIC_BASE_URL=http://127.0.0.1:8000

# 32-byte key, base64-encoded, used for AES-256-GCM at rest (source credentials, stream URLs).
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
IPTV_ENCRYPTION_KEY=

# Display timezone for the UI and notifications. Storage is always UTC.
IPTV_DISPLAY_TIMEZONE=Europe/Moscow

# SSRF policy: private targets (LAN sources) are refused unless this is explicitly enabled.
# Link-local and cloud-metadata addresses stay blocked either way.
IPTV_ALLOW_PRIVATE_NETWORK_TARGETS=0

# Public delivery endpoints: requests per minute per device token and client address (0 disables).
IPTV_PUBLIC_RATE_LIMIT_PER_MINUTE=120

# Smart-TV guard: a device guide larger than this is re-rendered with a narrower time window
# (7 days -> 3 -> 1). 0 disables the cap.
IPTV_EPG_MAX_BYTES=5000000

# Interactive API documentation (/docs, /redoc, /openapi.json). Unset follows the environment:
# on in development, off in production. Set to true only when a schema is genuinely needed.
# IPTV_ENABLE_DOCS=false

# Largest accepted request body in bytes (playlists and guides are uploaded as JSON).
IPTV_MAX_REQUEST_BYTES=67108864

# Probe depth. "passive" (default) checks reachability and reads at most 2 KB.
# "active" also runs ffprobe on the stream: it proves decodability and fills codecs/resolution,
# but needs the binary (build the image with --build-arg INSTALL_FFMPEG=true) and costs CPU.
IPTV_PROBE_MODE=passive
IPTV_PROBE_CONCURRENCY=2
IPTV_FFPROBE_PATH=ffprobe
IPTV_FFPROBE_TIMEOUT_SECONDS=12

# Telegram bot: leave the token empty to disable it. Long polling needs no inbound port.
IPTV_TELEGRAM_BOT_TOKEN=
IPTV_TELEGRAM_OWNER_ID=
